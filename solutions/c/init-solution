#!/usr/bin/env python3
"""Initialize a C solution from the local Cryptopals descriptions."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "tools"))

from scaffold import Challenge, load_challenge, write_new_file  # noqa: E402


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Initialize a C solution from the local challenge corpus."
    )
    parser.add_argument("set_number", type=int, metavar="SET")
    parser.add_argument("challenge_number", type=int, metavar="CHALLENGE")
    return parser.parse_args()


def c_template(challenge: Challenge) -> str:
    heading = (
        f"Set {challenge.set_number}, Challenge "
        f"{challenge.challenge_number}: {challenge.title}."
    )
    return f'''/*
 * {heading}
 * Online: {challenge.url}
 */

#include "../util.h"

#include <stdlib.h>

static const char *const EXPECTED = NULL;


/* Return a heap-allocated answer; run_and_verify frees it. */
static char *solve(void) {{
    return NULL;
}}


int main(void) {{
    return run_and_verify(solve, EXPECTED);
}}
'''


def main() -> int:
    args = parse_arguments()

    try:
        challenge = load_challenge(
            ROOT, args.set_number, args.challenge_number
        )
    except ValueError as error:
        raise SystemExit(f"error: {error}") from error

    destination = (
        ROOT
        / "solutions"
        / "c"
        / f"set{args.set_number:02d}"
        / f"ch{args.challenge_number:02d}.c"
    )
    try:
        write_new_file(ROOT, destination, c_template(challenge))
    except FileExistsError as error:
        raise SystemExit(
            f"error: refusing to overwrite {destination.relative_to(ROOT)}"
        ) from error
    except ValueError as error:
        raise SystemExit(f"error: {error}") from error

    print(f"created {destination.relative_to(ROOT)}")
    print(f"challenge: {challenge.url}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
